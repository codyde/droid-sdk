# Platform: telegram or discord
BOT_PLATFORM=telegram

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Discord Bot Token (get from Discord Developer Portal) - for future use
DISCORD_BOT_TOKEN=

# Factory API Key (OPTIONAL - only needed if not logged in via `droid` CLI)
# If you've run `droid` and logged in via browser, credentials are stored
# in ~/.factory/auth.encrypted and will be used automatically.
# Set this only to override local credentials (e.g., for CI/CD or server deployment)
# FACTORY_API_KEY=fk-...

# Droid Configuration
DROID_MODEL=claude-sonnet-4-5-20250929
DROID_CWD=/home/user/projects
DROID_REASONING=low
DROID_AUTONOMY=high
